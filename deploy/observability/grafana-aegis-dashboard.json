{
  "title": "Aegis Latent Core",
  "uid": "aegis-latent-core",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "aegis"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by status class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(aegis_requests_total[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "End-to-end request latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aegis_request_duration_seconds_bucket{stage=\"total\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aegis_request_duration_seconds_bucket{stage=\"total\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aegis_request_duration_seconds_bucket{stage=\"total\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Evidence commit duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aegis_audit_commit_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aegis_audit_commit_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Evidence commit lag (request to durable)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aegis_audit_commit_lag_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aegis_audit_commit_lag_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Commit errors and pending commits",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aegis_audit_commit_errors_total[5m])",
          "legendFormat": "commit errors/s"
        },
        {
          "refId": "B",
          "expr": "aegis_audit_pending_commits",
          "legendFormat": "pending commits"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Terminal outbox",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aegis_terminal_outbox_pending",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "rate(aegis_terminal_outbox_errors_total[5m])",
          "legendFormat": "errors/s"
        },
        {
          "refId": "C",
          "expr": "increase(aegis_terminal_outbox_recovered_total[1h])",
          "legendFormat": "recovered (1h)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "WAF blocks by layer",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (layer) (rate(aegis_waf_blocks_total[5m]))",
          "legendFormat": "{{layer}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rate limiting",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aegis_ratelimit_rejections_total[5m])",
          "legendFormat": "rejections/s"
        },
        {
          "refId": "B",
          "expr": "rate(aegis_ratelimit_backend_errors_total[5m])",
          "legendFormat": "backend errors/s"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Streams",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aegis_stream_admission_active",
          "legendFormat": "admitted now"
        },
        {
          "refId": "B",
          "expr": "increase(aegis_stream_admission_rejected_total[10m])",
          "legendFormat": "refused (10m)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(aegis_stream_tokens_total[5m]))",
          "legendFormat": "tokens/s"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream forwarding and circuit breaker",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(aegis_forward_errors_total[5m]))",
          "legendFormat": "errors {{stage}}"
        },
        {
          "refId": "B",
          "expr": "aegis_circuit_breaker_state",
          "legendFormat": "breaker {{provider}} (0 closed, 2 open)"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Enforcement mode (1 strict, 0 development)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aegis_security_enforcement_mode",
          "legendFormat": "mode"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Chain size",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aegis_audit_chain_nodes_total",
          "legendFormat": "nodes in the retained chain"
        }
      ]
    }
  ],
  "description": "Every expression uses a metric exported by aegis/core/observability.py. Not exercised against a live deployment."
}
