# ────────────────────────────────────────────────────────────────────
#  Aegis Latent Core — v2.2.0 .env.example
#  Copy to .env and fill in your values.  Never commit .env to git.
# ────────────────────────────────────────────────────────────────────

# ── Provider ─────────────────────────────────────────────────────────
# Valid values: openai | anthropic | gemini | openrouter
# Default: openai  (also covers any OpenAI-compatible endpoint)
AEGIS_PROVIDER=openai

# Optional: override the model sent upstream regardless of client request
# AEGIS_PROVIDER_MODEL=claude-opus-4-5

# ── Backend URL ───────────────────────────────────────────────────────
# For openai/openrouter/gemini the default URL is set by the provider adapter.
# Override only for custom or self-hosted endpoints.
# AEGIS_BACKEND_URL=http://localhost:11434        # Ollama
# AEGIS_BACKEND_URL=http://localhost:8000          # vLLM
# AEGIS_BACKEND_URL=https://openrouter.ai/api/v1

# ── API Keys ──────────────────────────────────────────────────────────
# The single AEGIS_BACKEND_API_KEY is forwarded to the configured provider.
AEGIS_BACKEND_API_KEY=sk-your-key-here

# For OpenRouter:
# AEGIS_BACKEND_API_KEY=sk-or-your-openrouter-key
# AEGIS_OPENROUTER_SITE_URL=https://yourapp.com
# AEGIS_OPENROUTER_SITE_NAME=YourApp

# For Anthropic:
# AEGIS_BACKEND_API_KEY=sk-ant-your-anthropic-key
# AEGIS_ANTHROPIC_API_VERSION=2023-06-01

# For Gemini:
# AEGIS_BACKEND_API_KEY=your-gemini-api-key

# ── Auth ─────────────────────────────────────────────────────────────
# Comma-separated keys that clients must send as Bearer tokens.
AEGIS_API_KEYS=your-proxy-key-1,your-proxy-key-2

# Dedicated HMAC-SHA256 signing key for the Merkle audit chain.
# MUST be different from AEGIS_API_KEYS.
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
AEGIS_SIGNING_KEY=

# ── Security ──────────────────────────────────────────────────────────
# Set to true ONLY for local development. Exposes /docs and /redoc.
AEGIS_DEBUG_MODE=false

# ── Telemetry ─────────────────────────────────────────────────────────
# Inject logprobs into requests for entropy analysis.
# Disabled by default — not supported by Anthropic/Gemini.
# Enable only with OpenAI-compatible backends.
AEGIS_FORCE_LOGPROBS=false
AEGIS_TOP_LOGPROBS=5

# ── Rate Limiting ─────────────────────────────────────────────────────
AEGIS_RATE_LIMIT_BACKEND=memory   # memory | redis
AEGIS_RATE_LIMIT_THRESHOLD=60
AEGIS_RATE_LIMIT_BURST=10
# AEGIS_REDIS_URL=redis://localhost:6379

# ── Storage (enterprise layer) ────────────────────────────────────────
AEGIS_STORAGE_PROVIDER=sqlite     # sqlite | postgres | dynamodb
AEGIS_SQLITE_DB_PATH=./data/aegis.db

# ── Server ────────────────────────────────────────────────────────────
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8080
AEGIS_LOG_LEVEL=INFO
