# Aegis Latent Core strict runtime example
# Copy to .env only for local configuration. Never commit real secrets.

# Shared enforcement
AEGIS_SECURITY_ENFORCEMENT_MODE=strict
AEGIS_REQUIRE_DURABLE_EVIDENCE=true
AEGIS_REQUIRE_LSM=true
AEGIS_REQUIRE_SECCOMP=true
AEGIS_REQUIRE_DISTRIBUTED_LIMITER=true
AEGIS_MAX_REQUEST_BODY_BYTES=1048576
AEGIS_MAX_FORENSIC_BYTES=1048576

# Proxy authentication and signing
AEGIS_API_KEYS=replace-with-client-bearer-key
AEGIS_AUDIT_API_KEYS=replace-with-audit-reader-key
AEGIS_AUTH_DISABLED=false
# Use a secret-manager value with at least 32 bytes of entropy.
AEGIS_SIGNING_KEY=replace-with-at-least-32-byte-secret

# Upstream provider. Must be an absolute http/https URL without userinfo.
AEGIS_BACKEND_URL=https://llm.internal.example/v1
AEGIS_BACKEND_API_KEY=inject-from-secret-manager
AEGIS_BACKEND_TIMEOUT_SECONDS=120
AEGIS_BACKEND_CONNECT_TIMEOUT_SECONDS=10

# Distributed rate limiting. Strict runtime rejects Redis failure.
AEGIS_RATE_LIMIT_BACKEND=redis
AEGIS_REDIS_URL=rediss://redis.internal.example:6380/0
AEGIS_RATE_LIMIT_THRESHOLD=60
AEGIS_RATE_LIMIT_BURST=10

# Durable evidence
AEGIS_WAL_PATH=/var/lib/aegis/aegis.wal.jsonl
AEGIS_MAX_MEMORY_NODES=100000
AEGIS_MAX_WAL_BYTES=1073741824
AEGIS_WAL_FSYNC=true

# Kernel enforcement. The process must run with actual Seccomp and LSM policy.
AEGIS_SECCOMP_PROFILE=/etc/aegis/seccomp.json
AEGIS_LSM_PROFILE=/etc/aegis/apparmor.profile

# Optional application-layer egress allowlist.
AEGIS_AIRGAP_MODE=true
AEGIS_AIRGAP_ALLOWED_HOSTS=llm.internal.example

# Response enrichment is bounded and non-authoritative for the evidence gate.
AEGIS_ANALYSIS_QUEUE_SIZE=1024
AEGIS_ANALYSIS_WORKERS=4
AEGIS_FORCE_LOGPROBS=true
AEGIS_TOP_LOGPROBS=5

# Enterprise persistence, if the enterprise API is enabled.
AEGIS_STORAGE_PROVIDER=postgres
AEGIS_POSTGRES_DSN=inject-from-secret-manager
AEGIS_POSTGRES_MIN_POOL_SIZE=2
AEGIS_POSTGRES_MAX_POOL_SIZE=16

# Listener and TLS are normally terminated by the deployment edge.
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8080
AEGIS_LOG_LEVEL=INFO
AEGIS_DEBUG_MODE=false
