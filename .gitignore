# ── Claude Code project tooling (internal — not for public distribution) ──────
# These files are useful locally but contain internal instructions and configs
# that should not be exposed in public repositories.
# To stop tracking already-committed files: git rm --cached -r .claude/ docs/audit/
.claude/
docs/audit/

# ── AI-session artifacts ───────────────────────────────────────────────────────
# Runtime artifacts produced by Claude Code sessions
*.claude-session
.claude-context/

# ── Generated tool artifacts (regenerated in CI / on demand) ───────────────────
# forensic_checks.py and generate_summary.py produce these; never commit them.
tools/forensic/report.json
tools/visualizer/summary.json
