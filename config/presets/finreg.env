# config/presets/finreg.env — Finance & Banking (SEC Rule 17a-4 / FINRA 4511 / MiFID II)
#
# Usage:
#   cp config/presets/finreg.env .env && $EDITOR .env   # fill in secrets
#   docker compose --env-file .env up -d
#
# Compliance context:
#   SEC Rule 17a-4(f) requires that electronic records be retained in a
#   non-rewriteable, non-erasable format (WORM). The audit WAL + sealed
#   compliance bundle satisfies this when backed by WORM-capable storage
#   (e.g. AWS S3 Object Lock, NetApp SnapLock, Azure Immutable Blob Storage).
#   FINRA 4511 extends the same requirement to member firms.
#   MiFID II RTS 24 requires tamper-proof records of order/execution activity
#   with a synchronized timestamp source.

# ── Provider ───────────────────────────────────────────────────────────────────
AEGIS_PROVIDER=openai
AEGIS_BACKEND_URL=https://api.openai.com

# ── Secrets (populate from Vault / AWS Secrets Manager — never hard-code) ──────
AEGIS_BACKEND_API_KEY=
AEGIS_API_KEYS=
AEGIS_AUDIT_API_KEYS=
AEGIS_SIGNING_KEY=          # 64-char hex HMAC key; rotate annually per FINRA 4511

# ── Audit chain ────────────────────────────────────────────────────────────────
AEGIS_WAL_PATH=/data/aegis.wal.jsonl
AEGIS_MAX_MEMORY_NODES=1000000          # Retain 1M nodes in-memory before eviction
AEGIS_FORCE_LOGPROBS=true               # Required for entropy analysis and FINRA evidence

# ── WORM compliance label ──────────────────────────────────────────────────────
# Set this in your Docker Compose or Kubernetes labels.
# Volume driver must be WORM-capable; set write-once retention ≥ 6 years per 17a-4(f)(3)(iii).
AEGIS_COMPLIANCE_PRESET=finreg
ENABLE_SEC17A4_LABELS=true

# ── Rate limiting ──────────────────────────────────────────────────────────────
AEGIS_RATE_LIMIT_BACKEND=redis
AEGIS_REDIS_URL=rediss://redis:6379/0
AEGIS_RATE_LIMIT_THRESHOLD=200
AEGIS_RATE_LIMIT_BURST=30

# ── Detection thresholds (tighter than default for financial data) ──────────────
AEGIS_KL_ALERT_THRESHOLD=1.5           # Tighter than default 2.0 — flag unusual token distributions
AEGIS_JS_ALERT_THRESHOLD=0.4

# ── TLS (mTLS required for MiFID II / FedWire / SWIFT connectivity) ────────────
AEGIS_SSL_CERTFILE=/certs/server.crt
AEGIS_SSL_KEYFILE=/certs/server.key
AEGIS_SSL_CA_CERTS=/certs/ca.crt

# ── Observability ──────────────────────────────────────────────────────────────
AEGIS_LOG_LEVEL=INFO
AEGIS_WEBHOOK_URL=          # SIEM/SOAR webhook for WAF block events

# ── Timestamp source (MiFID II RTS 25 — synchronized clock) ────────────────────
# Point to your NTP/PTP grandmaster; sync tolerance < 1ms for HFT environments.
# Aegis uses Python's time.time() which inherits the host NTP sync.
# Ensure host clock is synced: chronyc tracking | ntpstat
