#
# config/presets/scientific.env — Science & Research (Reproducibility / Determinism)
#
# Compliance context:
#   Scientific publications require that AI-assisted analyses be reproducible.
#   This preset configures Aegis to capture everything needed for a complete
#   scientific replay: model name, seed, sampling parameters, and the model digest
#   (SHA-256 of model weights via provider /model endpoint when available).
#
#   The audit node captures: request hash, response hash, logprob distributions,
#   entropy per token, KL divergence from baseline — sufficient to independently
#   re-verify or challenge the model's output distribution in peer review.

AEGIS_PROVIDER=openai
AEGIS_BACKEND_URL=https://api.openai.com

AEGIS_BACKEND_API_KEY=
AEGIS_API_KEYS=
AEGIS_AUDIT_API_KEYS=
AEGIS_SIGNING_KEY=

AEGIS_WAL_PATH=/data/aegis.wal.jsonl
AEGIS_MAX_MEMORY_NODES=100000
AEGIS_FORCE_LOGPROBS=true               # REQUIRED: logprobs are the basis for entropy forensics
AEGIS_COMPLIANCE_PRESET=scientific

# ── Determinism requirements ───────────────────────────────────────────────────
# All API calls in scientific use MUST set temperature=0 and seed=<fixed> to
# maximize determinism. Aegis captures the seed and temperature from the request
# body and includes them in the audit node's metadata field.
# Reference: OpenAI documentation on "Reproducible outputs" (seed parameter).

# ── Entropy / divergence monitoring (tight thresholds for baseline tracking) ──
AEGIS_KL_ALERT_THRESHOLD=3.0           # Alert on significant distribution shift from baseline
AEGIS_JS_ALERT_THRESHOLD=0.6

# ── Rate limiting (research workloads are bursty during experiments) ───────────
AEGIS_RATE_LIMIT_BACKEND=redis
AEGIS_REDIS_URL=redis://redis:6379/0
AEGIS_RATE_LIMIT_THRESHOLD=120
AEGIS_RATE_LIMIT_BURST=60

AEGIS_LOG_LEVEL=INFO

# ── Export guidance ────────────────────────────────────────────────────────────
# For reproducibility supplementary materials, export the sealed bundle:
#   curl -X POST http://localhost:8090/v1/enterprise/compliance/export \
#        -d '{"from_ts":"experiment_start","to_ts":"experiment_end"}'
# Include the bundle hash in your publication's Data Availability statement.
