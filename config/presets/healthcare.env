# config/presets/healthcare.env — Healthcare & Life Sciences
#                                 (HIPAA §164.312(b) / 21 CFR Part 11 / FDA AI SaMD)
#
# Compliance context:
#   HIPAA §164.312(b) — Audit Controls: implement hardware, software, and/or
#   procedural mechanisms to record and examine access to and actions that include
#   or use ePHI. Aegis provides the tamper-evident cryptographic audit trail.
#
#   21 CFR Part 11 — Electronic Records: records must be created by trustworthy and
#   reliable systems; signed audit trails with computerized system date/time stamps.
#
#   FDA AI/ML-based SaMD Guidance (2021 Action Plan): continuous monitoring and
#   performance tracking required; Aegis provides inference-level forensic records.
#
#   NIST SP 800-188 — De-Identification of Government Datasets: pseudonymize PII
#   before it enters the AI inference path.

AEGIS_PROVIDER=openai
AEGIS_BACKEND_URL=https://api.openai.com

AEGIS_BACKEND_API_KEY=
AEGIS_API_KEYS=
AEGIS_AUDIT_API_KEYS=
AEGIS_SIGNING_KEY=

AEGIS_WAL_PATH=/data/aegis.wal.jsonl
AEGIS_MAX_MEMORY_NODES=500000
AEGIS_FORCE_LOGPROBS=true

AEGIS_COMPLIANCE_PRESET=hipaa

# ── PHI de-identification ──────────────────────────────────────────────────────
# Aegis per-tenant SHA-256 pseudonymization. Set AEGIS_PHI_DEIDENTIFY=true to
# strip and pseudonymize HIPAA Safe Harbor §164.514(b) identifiers from audit nodes
# before writing to WAL. The WAL will contain the SHA-256(tenant+identifier) hash,
# not the raw PHI.
AEGIS_PHI_DEIDENTIFY=true
AEGIS_TENANT_ID_FIELD=user_id           # Field name in request metadata carrying patient/user ID

# ── Detection thresholds ────────────────────────────────────────────────────────
AEGIS_KL_ALERT_THRESHOLD=1.8           # Tighter — flag unusual responses that may hallucinate diagnoses
AEGIS_JS_ALERT_THRESHOLD=0.35

# ── Rate limiting ──────────────────────────────────────────────────────────────
AEGIS_RATE_LIMIT_BACKEND=redis
AEGIS_REDIS_URL=rediss://redis:6379/0
AEGIS_RATE_LIMIT_THRESHOLD=60
AEGIS_RATE_LIMIT_BURST=10

# ── TLS (BAA requirement: data encrypted in transit) ───────────────────────────
AEGIS_SSL_CERTFILE=/certs/server.crt
AEGIS_SSL_KEYFILE=/certs/server.key
AEGIS_SSL_CA_CERTS=/certs/ca.crt

AEGIS_LOG_LEVEL=INFO
AEGIS_WEBHOOK_URL=

# ── BAA note ───────────────────────────────────────────────────────────────────
# A Business Associate Agreement is required between your organization and the
# upstream LLM provider (OpenAI, Anthropic, Google, Azure, etc.) before sending
# any PHI through this proxy. Aegis does not modify or filter model input/output;
# the BAA must cover the entire chain.
