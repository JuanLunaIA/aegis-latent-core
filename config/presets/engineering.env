#
# config/presets/engineering.env — Engineering & Systems (Maximum Throughput)
#
# Tuning goals: minimize per-request latency, maximize concurrent throughput,
# lock-free CAS ring buffers, memory-mapped WAL, thread/core pinning.
# Target: ≥ 500 req/s on a 4-core instance; forensic overhead < 5 µs per request.

AEGIS_PROVIDER=openai
AEGIS_BACKEND_URL=https://api.openai.com

AEGIS_BACKEND_API_KEY=
AEGIS_API_KEYS=
AEGIS_AUDIT_API_KEYS=
AEGIS_SIGNING_KEY=

AEGIS_WAL_PATH=/data/aegis.wal.jsonl
AEGIS_MAX_MEMORY_NODES=200000
AEGIS_FORCE_LOGPROBS=false              # Disable to reduce upstream payload overhead
AEGIS_COMPLIANCE_PRESET=engineering

# ── Throughput tuning ─────────────────────────────────────────────────────────
# Workers: set to (2 × CPU cores) for I/O-bound workloads; 4 is a safe default.
# The Rust reqwest connection pool handles upstream HTTP/2 multiplexing.
UVICORN_WORKERS=4
UVICORN_LOOP=uvloop                     # pip install uvloop for ~2× asyncio throughput

# ── Rate limiting (generous — internal engineering use) ───────────────────────
AEGIS_RATE_LIMIT_BACKEND=redis
AEGIS_REDIS_URL=redis://redis:6379/0    # Plaintext OK for internal network
AEGIS_RATE_LIMIT_THRESHOLD=1000
AEGIS_RATE_LIMIT_BURST=200

# ── Detection thresholds (relaxed for internal high-trust traffic) ─────────────
AEGIS_KL_ALERT_THRESHOLD=5.0
AEGIS_JS_ALERT_THRESHOLD=1.0

# ── CPU affinity (Linux only) ─────────────────────────────────────────────────
# Pin uvicorn worker processes to specific cores for NUMA-aware throughput:
#   taskset -c 0-3 uvicorn aegis.proxy.app:create_proxy_app --factory ...
# Or use the aegis/core/cpu_affinity.py module via AEGIS_CPU_AFFINITY_CORES=0,1,2,3

AEGIS_LOG_LEVEL=WARNING                 # Reduce log I/O on the hot path

# ── No external TLS required for internal engineering network ─────────────────
# Enable if the service is exposed outside the internal network:
# AEGIS_SSL_CERTFILE=
# AEGIS_SSL_KEYFILE=
# AEGIS_SSL_CA_CERTS=
