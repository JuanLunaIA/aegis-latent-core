#
# config/presets/fedramp.env — FedRAMP High / DoD IL5 / IL6 / CMMC Level 3
#
# Compliance context:
#   FedRAMP High maps to NIST SP 800-53 Rev 5 High baseline. This preset
#   enables the control families most directly satisfied by Aegis:
#     AU-2  Audit Events             — all inference events logged
#     AU-3  Content of Audit Records — content, outcome, user ID, time captured
#     AU-9  Protection of Audit Info — HMAC-signed chain, WAL 0o600, off-system backup
#     AU-10 Non-Repudiation          — ML-DSA-65 post-quantum signatures
#     AU-11 Audit Record Retention   — compliance bundles, sealed exports
#     SC-8  Transmission Confidentiality — TLS/mTLS enforced
#     SC-13 Cryptographic Protection — FIPS 204 (ML-DSA), HMAC-SHA256, BLAKE3
#
#   DoD IL5 adds Bell-LaPadula ABAC, classified marker detection (SCI/SAP banners),
#   and SCADA/OT protocol injection scanning.
#
#   Air-gapped deployments: use musllinux static wheel (no dynamic libssl/libcrypto
#   required). See deploy/docker/Dockerfile.airgap and docs/RUST_BUILD.md.

AEGIS_PROVIDER=openrouter            # Or vllm/ollama for air-gapped on-premises LLM
AEGIS_BACKEND_URL=https://openrouter.ai

AEGIS_BACKEND_API_KEY=
AEGIS_API_KEYS=
AEGIS_AUDIT_API_KEYS=
AEGIS_SIGNING_KEY=

AEGIS_WAL_PATH=/data/aegis.wal.jsonl
AEGIS_MAX_MEMORY_NODES=2000000
AEGIS_FORCE_LOGPROBS=true

AEGIS_COMPLIANCE_PRESET=fedramp

# ── Classification and access control ─────────────────────────────────────────
# Enable Bell-LaPadula ABAC for DoD IL5 compartmentalization
AEGIS_ENABLE_ABAC=true
AEGIS_ABAC_DEFAULT_LABEL=UNCLASSIFIED
# AEGIS_CAC_PIV_CA=/certs/dod_piv_ca.crt  # DoD CAC/PIV client certificate CA

# ── mTLS (required for FedRAMP High AC-17 / SC-8) ─────────────────────────────
AEGIS_SSL_CERTFILE=/certs/server.crt
AEGIS_SSL_KEYFILE=/certs/server.key
AEGIS_SSL_CA_CERTS=/certs/dod_ca.crt      # DoD PKI root CA bundle

# ── FIPS-compliant algorithm enforcement ──────────────────────────────────────
# Aegis uses HMAC-SHA256 + ML-DSA-65 (FIPS 204) by default.
# For FIPS 140-3 host validation, run on a FIPS-enabled kernel/OpenSSL build.
# Static musllinux wheel carries vendored OpenSSL; use FIPS-enabled build in production.

# ── Detection (IL5/IL6) ────────────────────────────────────────────────────────
AEGIS_KL_ALERT_THRESHOLD=1.0            # Very tight — flag any unusual model behavior
AEGIS_JS_ALERT_THRESHOLD=0.3
# AEGIS_CLASSIFIED_MARKERS_ENABLED=true  # ClassifiedMarkerDetector (SCI/SAP banners) — on by default

# ── Rate limiting ──────────────────────────────────────────────────────────────
AEGIS_RATE_LIMIT_BACKEND=redis
AEGIS_REDIS_URL=rediss://redis:6379/0    # TLS Redis; use Redis FIPS build for IL6
AEGIS_RATE_LIMIT_THRESHOLD=100
AEGIS_RATE_LIMIT_BURST=15

# ── Seccomp (enabled by default; verify with: cat /proc/<pid>/status | grep Seccomp) ─
HERMES_SANDBOX=false                     # Set true only in CI/test; false in production

AEGIS_LOG_LEVEL=WARNING                  # Minimize log verbosity for classified environments
AEGIS_WEBHOOK_URL=                       # SIEM webhook (must be on classified network segment)
