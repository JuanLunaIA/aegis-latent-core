#
# config/presets/smb.env — SMBs / PyMEs / General Engineering (Zero-Friction Default)
#
# Goal: deploy in under 5 minutes with zero application changes, local SQLite WAL,
# auto-generated API keys, and automatic HTTP (non-TLS) for local dev networks.
# Upgrade to a full TLS/Redis/compliance config using one of the other presets.
#
# Quick start:
#   cp config/presets/smb.env .env
#   AEGIS_SIGNING_KEY=$(python -c 'import secrets; print(secrets.token_hex(32))') >> .env
#   AEGIS_API_KEYS=$(python -c 'import secrets; print("sk-aegis-" + secrets.token_hex(16))') >> .env
#   docker compose -f deploy/docker/docker-compose.yml --env-file .env up -d
#   curl -sf http://localhost:8080/health   # → {"status":"healthy"}

AEGIS_PROVIDER=openai
AEGIS_BACKEND_URL=https://api.openai.com

# ── Secrets: fill in or generate with the quick start above ────────────────────
AEGIS_BACKEND_API_KEY=
AEGIS_API_KEYS=
AEGIS_AUDIT_API_KEYS=
AEGIS_SIGNING_KEY=

# ── Audit storage: local SQLite (zero infrastructure required) ─────────────────
AEGIS_WAL_PATH=/data/aegis.wal.jsonl
AEGIS_STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite+aiosqlite:////data/aegis_server.db
AEGIS_MAX_MEMORY_NODES=50000

AEGIS_FORCE_LOGPROBS=true
AEGIS_COMPLIANCE_PRESET=standard

# ── Rate limiting: in-process token bucket (no Redis required) ─────────────────
AEGIS_RATE_LIMIT_BACKEND=asyncio        # Local asyncio lock — no external dependency
AEGIS_RATE_LIMIT_THRESHOLD=60
AEGIS_RATE_LIMIT_BURST=10

# ── Detection: standard thresholds ─────────────────────────────────────────────
AEGIS_KL_ALERT_THRESHOLD=2.0
AEGIS_JS_ALERT_THRESHOLD=0.5

# ── No TLS required for local / internal dev network ──────────────────────────
# Enable when the proxy is internet-accessible:
# AEGIS_SSL_CERTFILE=/certs/server.crt
# AEGIS_SSL_KEYFILE=/certs/server.key

AEGIS_LOG_LEVEL=INFO
AEGIS_WEBHOOK_URL=

# ── Next steps after proving out locally ──────────────────────────────────────
# 1. Switch to Redis for distributed rate limiting (AEGIS_RATE_LIMIT_BACKEND=redis)
# 2. Add TLS termination (nginx reverse proxy or direct AEGIS_SSL_CERTFILE/KEYFILE)
# 3. Point AEGIS_BACKEND_URL at your preferred LLM provider or on-premises vLLM
# 4. Rotate AEGIS_SIGNING_KEY quarterly and archive old sealed bundles
# 5. Upgrade to docker-compose.enterprise.yml for production hardening
