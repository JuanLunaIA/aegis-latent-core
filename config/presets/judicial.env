#
# config/presets/judicial.env — Forensic & Judicial (Daubert Standard / FRE 702)
#
# Compliance context:
#   Federal Rules of Evidence 702 (Daubert standard) requires that expert testimony
#   be based on "sufficient facts or data" derived from "reliable principles and
#   methods applied reliably to the facts of the case." For AI-generated forensic
#   evidence to be admissible, the recording system must be independently verifiable.
#
#   Aegis satisfies Daubert by providing:
#     1. SHA-256 hash-chained audit nodes — any post-hoc tampering is detectable
#     2. HMAC-SHA256 + ML-DSA-65 signatures — cryptographic non-repudiation
#     3. PKCS#7 CMS SignedData export — court-standard signed data format
#     4. EWF/E01 Expert Witness Format — accepted by US, UK, EU courts
#     5. Chain-of-custody metadata — provenance from LLM input to archived output
#     6. Offline re-verification — auditor can verify without access to live system
#
#   SWGDE (Scientific Working Group for Digital Evidence) guidelines:
#   The digital evidence must be acquired in a manner that preserves integrity.
#   The WAL fsync-per-node ensures crash consistency.

AEGIS_PROVIDER=openai
AEGIS_BACKEND_URL=https://api.openai.com

AEGIS_BACKEND_API_KEY=
AEGIS_API_KEYS=
AEGIS_AUDIT_API_KEYS=
AEGIS_SIGNING_KEY=

AEGIS_WAL_PATH=/data/aegis.wal.jsonl
AEGIS_MAX_MEMORY_NODES=5000000          # Large in-memory chain — forensic cases may span months
AEGIS_FORCE_LOGPROBS=true              # Required for Shannon entropy forensic analysis

AEGIS_COMPLIANCE_PRESET=judicial

# ── Chain-of-custody: never allow non-persisted nodes ─────────────────────────
# Do not reduce AEGIS_MAX_MEMORY_NODES in forensic deployments — eviction before
# export creates gaps in the chain-of-custody that opposing counsel can exploit.

# ── Rate limiting (forensic review systems are low-traffic) ───────────────────
AEGIS_RATE_LIMIT_BACKEND=redis
AEGIS_REDIS_URL=rediss://redis:6379/0
AEGIS_RATE_LIMIT_THRESHOLD=30
AEGIS_RATE_LIMIT_BURST=5

# ── Detection ─────────────────────────────────────────────────────────────────
AEGIS_KL_ALERT_THRESHOLD=1.5
AEGIS_JS_ALERT_THRESHOLD=0.35

# ── TLS (all forensic evidence transmission must be encrypted) ─────────────────
AEGIS_SSL_CERTFILE=/certs/server.crt
AEGIS_SSL_KEYFILE=/certs/server.key
AEGIS_SSL_CA_CERTS=/certs/ca.crt

AEGIS_LOG_LEVEL=INFO

# ── Export configuration ───────────────────────────────────────────────────────
# After deployment, generate sealed bundles regularly using aegis_server:
#   curl -X POST http://localhost:8090/v1/enterprise/compliance/export \
#        -H "Authorization: Bearer $AUDIT_KEY" \
#        -d '{"from_ts":"...","to_ts":"..."}'
# Export includes PKCS#7 CMS SignedData and EWF/E01 images suitable for
# Relativity / Nuix / EnCase / FTK ingestion.
